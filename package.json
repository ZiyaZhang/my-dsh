{
  "name": "dsh-my-dsh",
  "version": "0.3.0-dev.9",
  "description": "A board of matters for DeepSeek Harness, with my dsh: an assistant that answers, hands work to sessions, follows up and reminds",
  "type": "module",
  "license": "MIT",
  "author": "Ziya Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiyaZhang/my-dsh.git"
  },
  "homepage": "https://github.com/ZiyaZhang/my-dsh#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/host/index.js",
  "types": "./dist/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./tools": {
      "types": "./dist/types/host/tools.d.ts",
      "default": "./dist/host/tools.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-command-compact": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-persona": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-time-context": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-command-compact": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-time-context": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
